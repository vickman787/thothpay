# --- ThothPay / Celo mainnet ---
# Agent treasury wallet private key (the wallet that pays creators + refunds).
# This is the same key as PK in .env; PK is kept for the ERC-8004 scripts.
TREASURY_PRIVATE_KEY=
PK=

# Celo mainnet RPC (free public one by default)
CELO_RPC_URL=https://forno.celo.org

# Your ERC-8021 attribution tag from the Agents at Work hackathon registration
ATTRIBUTION_TAG=celo_38d9e4de3b9f

# Agent treasury address that receives x402 payments (your agent wallet)
AGENT_TREASURY_ADDRESS=0xcc4BCDD595Ee20cFB8A214Dc570eCB3Fb1C1d3A1

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Providers ---
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- Circle Web3 (legacy / x402 buy-side) ---
NEXT_PUBLIC_CIRCLE_APP_ID=
CIRCLE_WALLET_ID=
RAW_ENTITY_SECRET=
CIRCLE_API_KEY=
